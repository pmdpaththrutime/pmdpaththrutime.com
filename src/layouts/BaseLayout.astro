---
import "../styles/global.css";
import PageHeader from "../components/PageHeader.astro";
import PageFooter from "../components/PageFooter.astro";

interface Props {
  title?: string;
}

// Concatenate page title and site title if defined, otherwise just the site title
const { title } = Astro.props;
const site_title = "Mystery Dungeon: A Path Through Time"
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ title ? title + " - " + site_title : site_title }</title>
    <meta name="creator" content="The PTT Crew" />
    <!-- IETF AI Preferences signal; see https://www.aipref.dev/ for more info.
     This preference signal constitutes notice that the copyright holders of this
     website and its contents DO NOT AUTHORIZE the use of website content for the
     purpose of training any machine learning or AI model.
      -->
    <meta http-equiv="Content-Usage" content="train-ai=n, search=y" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <PageHeader />
    <slot />
    <PageFooter />
  </body>
</html>
