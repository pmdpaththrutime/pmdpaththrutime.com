---
import "../styles/global.css";
import PageHeader from "../components/PageHeader.astro";
import PageFooter from "../components/PageFooter.astro";
import JsonAldean from "../components/JsonAldean.astro";
import ConsentManager from "../components/ConsentManager";
import { WEBSITE_ROOT_URL } from "../constants";
import UrlCanonizer from "../components/UrlCanonizer.astro";

interface Props {
  title?: string;
  description?: string;
  includeLinkedData?: object;
}

// Concatenate page title and site title if defined, otherwise just the site title
const { title, description, includeLinkedData } = Astro.props;
const site_title = "Mystery Dungeon: A Path Through Time"

// The canonical URL for this page, without any UTM or other query parameters
const canonicalUrl = WEBSITE_ROOT_URL + Astro.url.pathname;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{ title ? title + " - " + site_title : site_title }</title>
    <meta name="creator" content="The PTT Crew" />
    {
      description && <meta name="description" content={description} />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
    />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {
      includeLinkedData && <JsonAldean data={includeLinkedData} />
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <UrlCanonizer />
  </head>
  <body>
    <ConsentManager client:only="react" />
    <PageHeader />
    <slot />
    <PageFooter />
  </body>
</html>
