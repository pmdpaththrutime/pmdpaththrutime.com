---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ExternalLink from "../../components/ExternalLink.astro";

const currentYear = new Date().getFullYear();
---

<BaseLayout title="Legal Notice" description="Copyright and trademark information about Mystery Dungeon: A Path Through Time">
  <main class="orange-background">
    <div id="hero" class="hero">
      <h1>Legal Notice</h1>
    </div>

    <div class="content-page-container">
      <article class="cream-background content-page">
        <p>
          <cite>Mystery Dungeon: A Path Through Time</cite> (<cite>PTT</cite>) &copy; &copysr; 2023-{currentYear} The PTT Crew and the persons
          identified as performers on each episode.
        </p>
        <p>
          All rights reserved. No portion of the <cite>PTT</cite> podcast, this website, or any derivative work thereof may be used
          in connection with the development of any digital voice replica or generative AI model without the express consent of the copyright owners.
        </p>
        <p>
          "Pokémon", "Pokémon Mystery Dungeon", and related names are trademarks of Nintendo. We are not affiliated with
          The Pokémon Company, Nintendo, Spike Chunsoft, or their affiliates.
          We believe in the power of <ExternalLink href="https://www.transformativeworks.org/what_we_believe/">transformative</ExternalLink>
          storytelling and do not intend to infringe on any copyrights or trademarks.
        </p>
      </article>
    </div>
  </main>
</BaseLayout>
