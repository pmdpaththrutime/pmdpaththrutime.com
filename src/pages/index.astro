---
import { Picture } from "astro:assets";
import CtaButton from "../components/CtaButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import NasCiteLink from "../components/NasCiteLink.astro";
import heroLogo from "../images/hero_logo.png";
import alchasRegionMap from "../images/alchas_region_map.webp";
import { SPOTIFY_URL, DISCORD_URL, ZENCASTR_URL } from "../constants.ts";
import { data } from "../json-ld/homepage.ts";

const ctaLinks = [
  {
    href: SPOTIFY_URL,
    label: "Listen on Spotify",
  },
  {
    href: DISCORD_URL,
    label: "Join Our Discord",
  },
  {
    href: ZENCASTR_URL,
    label: "Browse All Episodes",
  },
];

const characters = [
  {
    name: "Hikaru Hatsumi",
    species: "Pikachu",
    pronouns: "she/her",
  },
  {
    name: "Bruce Flameback",
    species: "Cyndaquil",
    pronouns: "he/him",
  },
  {
    name: "Walter Fisthands",
    species: "Riolu",
    pronouns: "he/him",
  },
  {
    name: "Salena",
    species: "Glaceon",
    pronouns: "she/her",
  },
  {
    name: "Brielle",
    species: "Umbreon",
    pronouns: "she/her",
  },
  {
    name: "Abyss",
    species: "Umbreon",
    pronouns: "he/him",
  },
];
---

<BaseLayout
    description="A Pokémon Mystery Dungeon TTRPG fan podcast"
    includeLinkedData={data}
    >
  <main>
    <section id="hero" class="hero orange-background">
      <div class="hero-content">
        <!-- Logo image -->
        <div class="hero-image">
          <Picture
            src={heroLogo}
            alt="Mystery Dungeon: A Path Through Time logo"
            title="Mystery Dungeon: A Path Through Time logo"
            formats={['avif', 'webp', 'png']}
            widths={[202, 420]}
            loading="lazy"
          />
        </div>

        <!-- Logline and blurb -->
        <h2 id="logline" class="hero-logline">
          A TTRPG podcast set in a world where only Pokémon live!
        </h2>

        <p id="blurb" class="hero-blurb">
          Follow the escapades of Hikaru the Pikachu, Bruce the Cyndaquil, and
          Walter the Riolu as they discover the mysteries of the Three Orbs and
          the spacetime rifts in this fan-driven actual play production.
          Available on Spotify, YouTube, and wherever else you get your podcasts!
        </p>

        <!-- Call to action buttons -->
        <div class="cta-buttons" aria-label="Listen and watch links">
          {ctaLinks.map((link) => <CtaButton {...link} />)}
        </div>
      </div>
    </section>

    <section id="story-detail" class="cream-background">
      <div class="story-detail-layout">
        <section id="about" class="story-panel">
          <div class="synopsis">
            <h2>About PTT</h2>
            <p>
              <cite>Mystery Dungeon: A Path Through Time</cite> (<cite>PTT</cite>) is a tabletop RPG podcast
              where we play <em>as</em> Pokémon using a homebrew game system and universe.
              Inspired by the <cite>Pokémon Mystery Dungeon</cite> video game series, the
              <cite>PTT</cite> campaign is set in the Alchas region,
              an industrialized society where Pokémon do all the things humans do in our world:
              talk, sing, go to school, play sports and video games&hellip; <i class="read-more">(<a href="/about">Read More</a>)</i>
            </p>
          </div>
        </section>

        <section id="characters" class="story-panel">
          <h2>Meet the Characters</h2>
          <div class="character-grid">
            {characters.map((character) => (
              <article class="character-card">
                <h3>{character.name}</h3>
                <p>Species: {character.species}</p>
                <p>Pronouns: {character.pronouns}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="setting" class="story-panel">
          <div class="setting-layout">
            <article id="setting-blurb">
              <h2>Explore the Alchas Region</h2>
              <p>
                Dive into the Alchas region, the unique campaign setting first
                introduced in our sister show <NasCiteLink />.
              </p>
            </article>

            <figure class="setting-figure">
              <Picture
                src={alchasRegionMap}
                alt="Map of the Alchas region"
                formats={['avif', 'webp', 'png']}
                widths={[256, 512, 657]}
                loading="lazy"
              />
              <figcaption>
                Map credit: <NasCiteLink />
              </figcaption>
            </figure>
          </div>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>
