---
import { Picture } from "astro:assets";
import CtaButton from "../components/CtaButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroLogo from "../images/hero_logo.png";
import { SPOTIFY_URL, DISCORD_URL, ZENCASTR_URL } from "../constants.ts";
import { data } from "../json-ld/homepage.ts";
import CharacterGallery from "../components/homepage/CharacterGallery.astro";
import AboutSection from "../components/homepage/AboutSection.astro";
import LatestEpisode from "../components/homepage/LatestEpisode.astro";

const ctaLinks = [
  {
    href: SPOTIFY_URL,
    label: "Listen on Spotify",
  },
  {
    href: DISCORD_URL,
    label: "Join Our Discord",
  },
  {
    href: ZENCASTR_URL,
    label: "Browse All Episodes",
  },
];
---

<BaseLayout
    description="A Pokémon Mystery Dungeon TTRPG fan podcast"
    includeLinkedData={data}
    >
  <main>
    <section id="hero" class="page-section hero orange-background">
      <div class="hero-content">
        <!-- Logo image -->
        <div class="hero-image">
          <Picture
            src={heroLogo}
            alt="Mystery Dungeon: A Path Through Time logo"
            formats={['avif', 'webp', 'png']}
            widths={[202, 420]}
            fetchpriority="high"
            loading="eager"
          />
        </div>

        <!-- Logline and blurb -->
        <h2 id="logline" class="hero-logline">
          A TTRPG podcast set in a world where only Pokémon live!
        </h2>

        <p id="blurb" class="hero-blurb">
          Follow Hikaru the Pikachu, Bruce the Cyndaquil, Sammy the Munchlax, and Walter the Riolu
          on their chaotic adventures through spacetime in this fan-run actual play show.
          Available on Spotify, YouTube, and wherever else you get your podcasts!
        </p>

        <!-- Call to action buttons -->
        <div class="cta-buttons" aria-label="Listen and watch links">
          {ctaLinks.map((link) => <CtaButton {...link} />)}
        </div>
      </div>
    </section>

    <section id="story-detail" class="page-section cream-background">
      <div class="story-detail-layout">
        <LatestEpisode />
        <CharacterGallery />
        <AboutSection />
      </div>
    </section>
  </main>
</BaseLayout>
