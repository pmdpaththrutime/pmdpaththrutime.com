---
import { Image } from "astro:assets";
import CtaButton from "../components/CtaButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroLogo from "../images/hero_logo.png";
import alchasRegionMap from "../images/alchas_region_map.webp";

const ctaLinks = [
  {
    href: "https://open.spotify.com/show/1ImfR6fAe241ATmhHHLP6C",
    label: "Listen on Spotify",
  },
  {
    href: "https://discord.gg/A7NCWyPkSd",
    label: "Join Our Discord",
  },
  {
    href: "https://zencastr.com/Mystery-Dungeon-a-Path-Through-Time",
    label: "Browse All Episodes",
  },
];
---

<BaseLayout>
  <header>
    <h1 class="nav-title">Mystery Dungeon: A Path Through Time</h1>
    <nav class="site-nav" aria-label="Primary">
      <a
        class="site-nav-link"
        href="https://linktr.ee/PMDPathThroughTime"
        target="_blank"
        rel="noopener noreferrer"
      >
        All our links
      </a>
      <a
        class="site-nav-link"
        href="https://open.spotify.com/show/1ImfR6fAe241ATmhHHLP6C"
        target="_blank"
        rel="noopener noreferrer"
      >
        Spotify
      </a>
      <a
        class="site-nav-link"
        href="https://www.youtube.com/@MysteryDungeonPTT"
        target="_blank"
        rel="noopener noreferrer"
      >
        YouTube
      </a>
      <a
        class="site-nav-link"
        href="https://discord.gg/A7NCWyPkSd"
        target="_blank"
        rel="noopener noreferrer"
      >
        Discord
      </a>
      <a
        class="site-nav-link"
        href="https://www.patreon.com/c/MysteryDungeonPTT/posts"
        target="_blank"
        rel="noopener noreferrer"
      >
        Patreon
      </a>
    </nav>
  </header>

  <main>
    <section id="hero" class="hero orange-background">
      <div class="hero-content">
        <div class="hero-image">
          <Image
            src={heroLogo}
            alt="Mystery Dungeon: A Path Through Time logo"
            title="Mystery Dungeon: A Path Through Time logo"
          />
        </div>

        <h2 id="logline" class="hero-logline">
          A TTRPG podcast set in a world where only Pokemon live!
        </h2>

        <p id="blurb" class="hero-blurb">
          Follow the escapades of Hikaru the Pikachu, Bruce the Cyndaquil, and
          Walter the Riolu as they discover the mysteries of the Three Orbs and
          the spacetime rifts in this fan-driven actual play production.
          Available on Spotify, YouTube, and wherever else you get your
          podcasts!
        </p>

        <div class="cta-buttons" aria-label="Listen and watch links">
          {ctaLinks.map((link) => <CtaButton {...link} />)}
        </div>
      </div>
    </section>

    <section id="story-detail" class="cream-background">
      <div class="story-detail-layout">
        <section id="characters" class="story-panel">
          <h2>Meet the Characters</h2>
          <div class="character-grid">
            <article class="character-card">
              <h3>Hikaru Hatsumi</h3>
              <p>Species: Pikachu</p>
              <p>Pronouns: she/her</p>
            </article>
            <article class="character-card">
              <h3>Bruce Flameback</h3>
              <p>Species: Cyndaquil</p>
              <p>Pronouns: he/him</p>
            </article>
            <article class="character-card">
              <h3>Walter Fisthands</h3>
              <p>Species: Riolu</p>
              <p>Pronouns: he/him</p>
            </article>
            <article class="character-card">
              <h3>Salena</h3>
              <p>Species: Glaceon</p>
              <p>Pronouns: she/her</p>
            </article>
            <article class="character-card">
              <h3>Brielle</h3>
              <p>Species: Umbreon</p>
              <p>Pronouns: she/her</p>
            </article>
            <article class="character-card">
              <h3>Abyss</h3>
              <p>Species: Umbreon</p>
              <p>Pronouns: he/him</p>
            </article>
          </div>
        </section>

        <section id="setting" class="story-panel">
          <div class="setting-layout">
            <article id="setting-blurb">
              <h2>Explore the Alchas Region</h2>
              <p>
                Dive into the Alchas region, the unique campaign setting first
                introduced in our sister show
                <a
                  href="https://www.notascratchcast.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <cite>Not A Scratch</cite>
                </a>.
              </p>
            </article>

            <figure class="setting-figure">
              <Image src={alchasRegionMap} alt="Map of the Alchas region" />
              <figcaption>
                Credit:
                <a
                  href="https://www.notascratchcast.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <cite>Not A Scratch</cite>
                </a>
              </figcaption>
            </figure>
          </div>
        </section>
      </div>
    </section>
  </main>

  <footer>
    <small class="ip-notices">
      Website &copy; 2026 The PTT Crew. All episodes &copy; 2023-2026 their
      respective authors.
    </small>
    <small class="ip-notices">
      Pokemon and related names are trademarks of Nintendo. We are not
      affiliated with The Pokemon Company, Nintendo, Spike Chunsoft, or their
      affiliates.
    </small>
    <small class="ip-notices">
      <cite>Mystery Dungeon: A Path Through Time</cite> is performed &amp;
      produced by humans.
    </small>
  </footer>
</BaseLayout>
