---
import ExternalLink from "./ExternalLink.astro";

const currentPath = Astro.url.pathname;
const { href } = Astro.props;
---
{(href.startsWith("https://") || href.startsWith("http://")) ? (
    // Use ExternalLink for external links
    <ExternalLink class="site-nav-link" href={href}>
      <slot />
    </ExternalLink>
  ) : (
    (currentPath === href) ? (
      // If the link is for the current page, render it as a non-link with active styling
      <span class="site-nav-link">
        <slot />
      </span>
    ) : (
      // Otherwise, render a normal internal link
      <a class="site-nav-link" href={href}>
        <slot />
      </a>
    )
  )}
