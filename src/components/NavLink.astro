---
import ExternalLink from "./ExternalLink.astro";

const currentPath = Astro.url.pathname;
const { href } = Astro.props;
---
{(href.startsWith("https://") || href.startsWith("http://")) ? (
    // Use ExternalLink for external links
    <ExternalLink class="nav-link" href={href}>
      <slot />
    </ExternalLink>
  ) : (
    (currentPath === href) ? (
      // If the link is for the current page, render it as a no-href link with the same
      // styling to ensure a consistent look and feel across all pages, but with
      // appropriate semantics for screen readers
      <a class="nav-link" role="link" aria-disabled="true">
        <slot />
      </a>
    ) : (
      // Otherwise, render a normal internal link
      <a class="nav-link" href={href}>
        <slot />
      </a>
    )
  )}
