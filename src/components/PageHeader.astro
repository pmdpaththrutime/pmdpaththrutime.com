---
import ExternalLink from "./ExternalLink.astro";
import { SPOTIFY_URL, YOUTUBE_URL, DISCORD_URL, PATREON_URL, LINKTREE_URL } from "../constants.ts";

const navLinks = [
  {
    href: "/faq",
    label: "FAQ",
  },
  {
    href: LINKTREE_URL,
    label: "All our links",
  },
  {
    href: SPOTIFY_URL,
    label: "Spotify",
  },
  {
    href: YOUTUBE_URL,
    label: "YouTube",
  },
  {
    href: DISCORD_URL,
    label: "Discord",
  },
  {
    href: PATREON_URL,
    label: "Patreon",
  },
];
---
<header>
  <h1 class="nav-title">
    <a class="site-nav-link" href="/">Mystery Dungeon: A Path Through Time</a>
  </h1>
  <nav class="site-nav" aria-label="Primary">
    {navLinks.map((link) => (
      // Use ExternalLink for external links and regular <a> for internal links
      (link.href.startsWith("https://") || link.href.startsWith("http://")) ? (
        <ExternalLink class="site-nav-link" href={link.href}>
          {link.label}
        </ExternalLink>
      ) : (
        <a class="site-nav-link" href={link.href}>
          {link.label}
        </a>
      ))
    )}
  </nav>
</header>
