---
import NavLink from "./NavLink.astro";
import { SPOTIFY_URL, YOUTUBE_URL, DISCORD_URL, PATREON_URL, LINKTREE_URL } from "../constants.ts";

const navLinks = [
  {
    href: "/faq",
    label: "FAQ",
  },
  {
    href: LINKTREE_URL,
    label: "All our links",
  },
  {
    href: SPOTIFY_URL,
    label: "Spotify",
  },
  {
    href: YOUTUBE_URL,
    label: "YouTube",
  },
  {
    href: DISCORD_URL,
    label: "Discord",
  },
  {
    href: PATREON_URL,
    label: "Patreon",
  },
];
---
<header>
  <h1 class="nav-title">
    <NavLink href="/">Mystery Dungeon: A Path Through Time</NavLink>
  </h1>
  <nav class="site-nav" aria-label="Primary">
    {navLinks.map((link) => (
      <NavLink href={link.href}>{link.label}</NavLink>
      )
    )}
  </nav>
</header>
