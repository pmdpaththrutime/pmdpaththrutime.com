---
import NavLink from "./NavLink.astro";
import { SPOTIFY_URL, YOUTUBE_URL, DISCORD_URL, PATREON_URL } from "../constants.ts";

import { Icon } from 'astro-icon/components';
import ExternalLink from "./ExternalLink.astro";

const navLinks = [
  {
    href: "/about",
    label: "About",
  },
  {
    href: "/faq",
    label: "FAQ",
  },
];

const iconLinks = [
  {
    href: SPOTIFY_URL,
    icon: "simple-icons:spotify",
    hint: "Spotify",
  },
  {
    href: YOUTUBE_URL,
    icon: "simple-icons:youtube",
    hint: "YouTube",
  },
  {
    href: DISCORD_URL,
    icon: "simple-icons:discord",
    hint: "Discord",
  },
  {
    href: PATREON_URL,
    icon: "simple-icons:patreon",
    hint: "Patreon",
  },
]
---
<header>
  <h1 class="nav-title">
    <NavLink href="/">Mystery Dungeon: A Path Through Time</NavLink>
  </h1>
  <nav class="header-nav" aria-label="Primary">
    {navLinks.map((link) => (
      <NavLink href={link.href}>{link.label}</NavLink>
      )
    )}
    {iconLinks.map((link) => (
      <ExternalLink href={link.href} class="icon-link">
        <Icon name={link.icon} title={link.hint} size={20} />
      </ExternalLink>
    ))}
  </nav>
</header>
