---
// A parody cookie consent banner.
---
<dialog class="cookie-dialog" open aria-modal="false" role="dialog"
  aria-labelledby="cookie-dialog-title"
  aria-describedby="cookie-dialog-description">
  <h3 id="cookie-dialog-title">Come to the dark side&hellip;</h3>
  <p id="cookie-dialog-description">Cookies are tasty, but we don't serve them here. We <em>will</em> assume you are OK with this.</p>
  <button class="cta-button" onclick="document.querySelector('.cookie-dialog').close()">
    Yeah, whatever
  </button>
</dialog>
