---
// Component that inserts a remote image from https://sprites.pmdcollab.org/
// Note: Authorship information cannot be fetched programmatically from the website
// and must be provided.
// All fan-made images are licensed under CC BY-NC 4.0.
import { Image } from 'astro:assets';

export interface PmdSpriteData {
  speciesID: number;
  formID?: number;
  isShiny?: boolean;
  emotion?: string;
  authors?: string[];
  license?: string;
}

interface Props {
  spriteData: PmdSpriteData;
  size?: number;
  hideCaption?: boolean;
}

const { spriteData, size, hideCaption } = Astro.props;

const urlBase = "https://raw.githubusercontent.com/PMDCollab/SpriteCollab/master/portrait/";

function padFourDigits(n: number) {
  return n.toString().padStart(4, "0");
}

function generateSpriteUrl(spriteData: PmdSpriteData) {
  var url = urlBase + padFourDigits(spriteData.speciesID) + "/";
  if (spriteData.formID) {
    url += padFourDigits(spriteData.formID) + "/";
    if (spriteData.isShiny) {
      url += "0001/";
    }
  }
  if (!spriteData.formID && spriteData.isShiny) {
    url += "0000/0001/";
  }
  url += (spriteData.emotion || "Normal") + ".png"
  return url;
}

const spriteUrl = generateSpriteUrl(spriteData);
---
<figure class={"pmd-sprite" + (spriteData.isShiny ? " shiny" : "")}>
  <Image src={spriteUrl} alt="" width={size} height={size} />
  {!hideCaption && (
    <figcaption class="pmd-sprite-caption">
      Credit: { spriteData.authors ? spriteData.authors.join(", ") : "Spike Chunsoft" }
    </figcaption>
  )}
</figure>
