---
import SpotifyEmbed from "../SpotifyEmbed.astro";
import ExternalLink from "../ExternalLink.astro";

---
<section id="play-latest" class="story-panel embed-section">
  <h2>Latest Episode</h2>
  <p>
    Listen to the latest episode of <cite>Mystery Dungeon: A Path Through Time</cite>
    below:
  </p>
  <div class="embed-wrapper">
    <SpotifyEmbed />
  </div>
  <small>
    Please note: You may need to enable third-party cookies from Spotify for the embedded
    media player above to work properly. These cookies are set by Spotify subject to its
    <ExternalLink href="https://www.spotify.com/us/legal/cookies-policy/">Cookies Policy</ExternalLink>.
  </small>
</section>
